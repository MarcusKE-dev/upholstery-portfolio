{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "cloudflare/**/*.ts",
    "lib/constants.ts",
    "lib/project.ts",
    "lib/portfolio-html.ts",
    "lib/public-projects.ts",
    "lib/content.ts"
  ]
}
